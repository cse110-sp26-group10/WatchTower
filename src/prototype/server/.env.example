# Local (npx supabase start → npx supabase status)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Remote (Supabase dashboard → Settings → API)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications (Gmail SMTP via nodemailer) ---
# Required to send email alerts. Use a Gmail App Password (account needs 2FA),
# not the normal password. Without these, email is skipped and push still works.
SMTP_USER=your.alerts@gmail.com
SMTP_PASS=your16charapppassword
SMTP_FROM=WatchTower <your.alerts@gmail.com>
